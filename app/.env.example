# Database (use localhost:5431 when running `dotnet run` on your Mac)
# Docker Compose overrides host to `db` and port to 5432 for the api service.
#
# Shared Azure dev (example — set in app/.env, never commit secrets):
# App__DatabaseUrl=postgresql://USER:PASSWORD@HOST.postgres.database.azure.com:5432/dev-db?sslmode=require
# Trovesuite__Database__Host=HOST.postgres.database.azure.com
# Trovesuite__Database__Port=5432
# Trovesuite__Database__Database=dev-db
# Trovesuite__Database__Username=USER
# Trovesuite__Database__Password=PASSWORD
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5431
DB_NAME=zeloshrdb
DB_USER=user
DB_PASSWORD=password

# Application
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=your-secret-key-at-least-32-characters-long
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# JWT
JWT_SECRET_KEY=your-jwt-secret-at-least-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=300

# App identity
APP_ID=app-zeloshr
APP_URL=https://zeloshr.com

# GitHub Packages — required to restore Trovesuite.Package in Docker/local build
# Create at: GitHub → Settings → Developer settings → PAT (read:packages)
# Variable name must be exactly GITHUB_PACKAGES_TOKEN (not IT HUB_PACKAGES_TOKEN)
GITHUB_PACKAGES_TOKEN=

# Trovesuite.Package — set TrovesuiteIntegration__RequireAuthentication=true for JWT-only API
TrovesuiteIntegration__RequireAuthentication=false
# Every /api/v1/* request requires app-id, authorization, bus-id, loc-id, org-id (see docs/SWAGGER.md)
TrovesuiteIntegration__RequireStandardHeaders=true
TrovesuiteIntegration__ValidatePlatformContext=true
# Local demo Trove headers (Trove id format; match LocalDevelopment in appsettings.Development.json):
# TROVE_ORG_ID=org_bcf5a0951f5ed22448dc5262e641e428caa3638d38b94cfa3b79c13d38a
# TROVE_BUS_ID=bus_5d929457b0ea7e6d55c5da25c8cfb38aeef0573658121bf5399f6f1e64d
# TROVE_LOC_ID=loc_c79fd9a5c53a8eaa82805e63a84da112387743c5dcdff7f7b254c02302c
# LocalDevelopment__TenantId=demo-tenant
# LocalDevelopment__DemoAdminUserId=u1000001-0000-4000-8000-000000000001

# Schema: deploy via compose (see docs/LOCAL_DEV.md). Do not enable for production.
# App__RunDatabaseMigrations=true

# Compose / tvs-sqlscript (used by ./scripts/compose.sh migrate)
# TVS_SQLSCRIPT_PATH=../tvs-sqlscript
# API_PORT=8000
