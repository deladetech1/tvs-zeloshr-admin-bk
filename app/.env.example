# Build-only: PAT for Trovesuite.Package restore (org secret name PACKAGES_TOKEN).
PACKAGES_TOKEN=

# Optional runtime overrides — defaults are in app/appsettings*.json (see docs/APPCONFIG.md).
# App__ConnectionString=postgresql://user:password@host:5432/dbname
# Trovesuite__Jwt__SecretKey=change-me-in-production-use-32-chars-min

# Compose: ASPNETCORE_ENVIRONMENT=Docker (appsettings.Docker.json). Optional:
# TROVESUITE_REQUIRE_AUTH=true
# TVS_SQLSCRIPT_PATH=../tvs-sqlscript
# API_PORT=8000
