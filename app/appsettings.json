{
  "App": {
    "AppName": "ZelosHR API",
    "AppVersion": "1.0.0",
    "Environment": "development",
    "Debug": true,
    "LogLevel": "Information",
    "LogDir": "logs",
    "AppId": "app-zeloshr",
    "AppUrl": "https://zeloshr.com",
    "CorsOrigins": "http://localhost:3000,http://localhost:8080",
    "DbHost": "localhost",
    "DbPort": "5431",
    "DbName": "zeloshrdb",
    "DbUser": "user",
    "DbPassword": "password",
    "SecretKey": "change-me-in-production-use-32-chars-min",
    "Algorithm": "HS256",
    "AccessTokenExpireMinutes": 300,
    "ActivityLogsTable": "zeloshr.zhr_activity_logs",
    "RunDatabaseMigrations": false
  },
  "Trovesuite": {
    "Database": {
      "Host": "localhost",
      "Port": 5431,
      "Database": "zeloshrdb",
      "Username": "user",
      "Password": "password",
      "ApplicationName": "ZelosHR.Api"
    },
    "Jwt": {
      "SecretKey": "change-me-in-production-use-32-chars-min",
      "Algorithm": "HS256",
      "AccessTokenExpireMinutes": 300
    },
    "Mail": {
      "SenderEmail": "",
      "SenderPassword": "",
      "SmtpHost": "smtp.gmail.com",
      "SmtpPort": 465,
      "UseSsl": true
    },
    "AzureStorage": {
      "AccountName": ""
    },
    "App": {
      "Name": "ZelosHR",
      "Environment": "development",
      "AppUrl": "https://zeloshr.com"
    }
  },
  "TrovesuiteIntegration": {
    "RequireAuthentication": false,
    "HrAdminPermission": null
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
