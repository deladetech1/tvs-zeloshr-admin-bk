# Copy to live-session.env (gitignored) after Trove login. Never commit live-session.env.
#
#   cp scripts/local-dev/live-session.example.env scripts/local-dev/live-session.env
#   # paste Bearer token from browser DevTools → Network → any API call → authorization header

# Dev backends (same-site as https://zeloshr.dev.trovesuite.com)
ZELOSHR_API_BASE=https://zeloshr.app.backend.dev.trovesuite.com
# For local API + dev Postgres: run pull-azure-dev-env.sh, run-api-live-db.sh, then in live-db.env set:
# ZELOSHR_API_BASE=http://localhost:8000
CORE_PLATFORM_API_BASE=https://core-platform.app.backend.dev.trovesuite.com

TROVE_APP_ID=app-hr
# Token only — no "Bearer " prefix
TROVE_BEARER_TOKEN=

TROVE_ORG_ID=org_
TROVE_BUS_ID=bus_
TROVE_LOC_ID=loc_

# From JWT (optional; for reference / scripts)
TROVE_USER_ID=
# Must match JWT claim exactly (see dev cp_business_app_locations for your org)
TROVE_TENANT_ID=tnt_

# Optional: run GET /employees/get in test-employees.sh
# EMPLOYEE_ID=

# Optional: pin leave E2E mutations (tests/e2e/leave); otherwise first list row is used
# LEAVE_TYPE_ID=
