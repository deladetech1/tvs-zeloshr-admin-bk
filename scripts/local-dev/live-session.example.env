# Copy to live-session.env (gitignored) after Trove login. Never commit live-session.env.
#
#   cp scripts/local-dev/live-session.example.env scripts/local-dev/live-session.env
#   # paste Bearer token from browser DevTools → Network → any API call → authorization header

# Dev backends (same-site as https://zeloshr-admin.dev.trovesuite.com)
ZELOSHR_API_BASE=https://zhr-admin.dev.backend.trovesuite.com
CORE_PLATFORM_API_BASE=https://cp.dev.backend.trovesuite.com

TROVE_APP_ID=app-zeloshr
# Token only — no "Bearer " prefix (paste from browser DevTools → Network → authorization)
TROVE_BEARER_TOKEN=

# Trove context headers (from any authenticated API call in DevTools)
TROVE_ORG_ID=org_1bc91292f0c6369af48879d04039e555a98ce392e7250e4d7d5458855c7
TROVE_BUS_ID=bus_31f8238d51a138e79fc16be025c83130b1a45a412d64be5e7a707a72543
TROVE_LOC_ID=loc_19ac0efe9eb60ea503f041d48d7a69f8c4f066596691014e71a55bdcf8c

# From JWT payload (optional; for core-platform scripts)
TROVE_USER_ID=uid_1f3e37eeb4b92d37a2e8dced488560ce60c906befce9b864f0effbf7948
TROVE_TENANT_ID=tnt_408344e90b0a05c74bb6d87bca9e97d6f945798d2a29a7193c56f0cc339

# Optional: run GET /employees/get in test-employees.sh
# EMPLOYEE_ID=

# Optional: pin leave E2E mutations (tests/e2e/leave); otherwise first list row is used
# LEAVE_TYPE_ID=
