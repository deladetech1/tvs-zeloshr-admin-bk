# Copy to live-db.env (gitignored). Or run: ./scripts/local-dev/pull-azure-dev-env.sh
#
# Same PostgreSQL as trovesuite-dev-zeloshr-ca (dev-db on trovesuite-shared-sql).
# Use for local API against real dev data — do NOT run migrations against this DB.

APP__CONNECTION_STRING=postgresql://USER:PASSWORD@trovesuite-shared-sql.postgres.database.azure.com:5432/dev-db?sslmode=require

# Match Container App auth (use scripts/local-dev/.jwt-secret.local after pull-azure-dev-env.sh)
TROVESUITE__JWT__SECRET_KEY=

# Optional override when testing local API instead of deployed URL
# ZELOSHR_API_BASE=http://localhost:8000
